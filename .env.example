# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca versione.

# Banco DuckDB do SIH-RD (15,4 GB). Fica fora do repositório.
# Aceita URL estilo SQLAlchemy ou caminho absoluto.
DATABASE_PATH=duckdb:////caminho/para/sihrd5.duckdb?access_mode=read_only

# Chave da OpenAI.
OPENAI_API_KEY=sk-...

# --- Opcionais (valores abaixo são os padrões) ---
# SQL_MODEL=gpt-5-mini
# ANSWER_MODEL=gpt-5-mini
# MAX_ROWS_TO_LLM=50
# DEFAULT_LIMIT=100
# QUERY_TIMEOUT_S=120
# MAX_REPAIR_ATTEMPTS=2
