# ---------------------------------------------------------------------------
# Segredos — NUNCA versionar. O .env carrega a OPENAI_API_KEY.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------------------
# Ambiente e cache
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editor e sistema operacional
# ---------------------------------------------------------------------------
.idea/
.vscode/
.DS_Store

# ---------------------------------------------------------------------------
# Banco de dados — o arquivo DuckDB tem 15 GB e mora fora do projeto
# ---------------------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.parquet

# ---------------------------------------------------------------------------
# Artefatos de avaliação regeráveis.
# `gold_snapshot.json` e `validation_228.json` FICAM versionados: são o
# resultado conferido de cada gold e a auditoria da importação.
# ---------------------------------------------------------------------------
# O detalhe caso a caso de cada execução: 400 KB por rodada, e regerável a
# partir do ground truth. O `resumo.md` e o `indice.md`, que são a SÉRIE de
# medições, ficam versionados — é neles que se vê se uma mudança ajudou.
eval/results/*/relatorio.json
eval/*.log
eval/.DS_Store
.DS_Store
eval/ground_truth_*_backup.yaml
eval/ground_truth_merged.yaml

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
*.local

# navegadores baixados pelo playwright (só o script de screenshots usa)
frontend/test-results/

# temas de investigação salvos localmente
data/temas/
data/chats/
eval/*.bak
data/paineis/
